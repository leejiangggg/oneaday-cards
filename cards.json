        "examples": [
          {
            "english": "Would you mind sending it again?",
            "korean": "다시 보내주실 수 있을까요?"
          },
          {
            "english": "I'd like to hear your take on this.",
            "korean": "이 건에 대한 네 생각을 듣고 싶어."
          }
        ]
      },
